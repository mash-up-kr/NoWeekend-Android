<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="team.noweekend.NoWeekendApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NoWeekend">

        <activity
            android:name="team.noweekend.feature.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="team.noweekend.feature.main.MainActivity"
            android:exported="false" />
        <activity
            android:name="team.noweekend.feature.login.LoginActivity"
            android:exported="false" />

        <activity
            android:name="team.noweekend.feature.create.vacation.CreateVacationActivity"
            android:exported="false" />

        <activity
            android:name="team.noweekend.feature.onboarding.OnboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="team.noweekend.feature.detail.date.DetailDateActivity"
            android:exported="false" />
    </application>
</manifest>